CREATE FUNCTION public.fn_get_customer_debt(p_customerid integer) RETURNS numeric
    LANGUAGE plpgsql
    AS $$
DECLARE
    v_total_debt NUMERIC := 0;
BEGIN
    -- חישוב סכום ההזמנות שהסטטוס שלהן הוא "לא שולם" (נניח שסטטוס 1 זה "לא שולם")
