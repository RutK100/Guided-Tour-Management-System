CREATE PROCEDURE public.pr_register_customer(IN p_customerid integer, IN p_tourid integer)
    LANGUAGE plpgsql
    AS $$
DECLARE
    v_spots_left INTEGER;
    v_new_registrationid INTEGER;
BEGIN
    v_spots_left := fn_get_remaining_spots(p_tourid);

    IF v_spots_left > 0 THEN

        SELECT COALESCE(MAX(registrationid), 0) + 1
        INTO v_new_registrationid
        FROM registration;

        INSERT INTO registration (
            registrationid,
            registrationdate,
            amounttopay,
            notes,
            tourid,
            registrationstatusid,
            customerid,
            numpeople
        )
        VALUES (
            v_new_registrationid,
            CURRENT_DATE,
            0,
            'Added by pr_register_customer',
            p_tourid,
            1,
            p_customerid,
            1
        );

        RAISE NOTICE 'Registration successful. Customer %, tour %, registration ID %, spots left after registration: %',
            p_customerid, p_tourid, v_new_registrationid, v_spots_left - 1;

    ELSE
        RAISE EXCEPTION 'No spots left for tour ID: %', p_tourid;
    END IF;

EXCEPTION
    WHEN OTHERS THEN
        RAISE EXCEPTION 'Failed to register customer: %', SQLERRM;
END;
$$;


